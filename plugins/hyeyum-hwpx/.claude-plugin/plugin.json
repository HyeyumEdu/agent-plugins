{
  "name": "hyeyum-hwpx",
  "displayName": "혜윰학원 한글 플러그인",
  "version": "1.2.0",
  "description": "혜윰학원 국어 시험지 한글 문서(HWPX)를 만드는 MCP와 스킬이에요.",
  "author": {
    "name": "JunseoKR"
  },
  "repository": "https://github.com/HyeyumEdu/agent-plugins",
  "license": "Apache-2.0",
  "mcpServers": {
    "hyeyum-hwpx-toolkit": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--quiet",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/server",
        "src/server.py",
        "${CLAUDE_PROJECT_DIR}",
        "${HOME:-}/Documents",
        "${HOME:-}/Desktop",
        "${HOME:-}/Downloads"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}
