{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hyeyum-hwpx-toolkit": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--frozen", "--quiet", "--directory", "./server", "src/server.py"],
      "cwd": "./",
      "env": { "PYTHONDONTWRITEBYTECODE": "1" }
    }
  }
}
