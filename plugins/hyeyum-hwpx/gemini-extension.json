{
  "name": "hyeyum-hwpx",
  "version": "1.0.0",
  "description": "고등학교 국어 시험지를 한글(.hwpx)로 만드는 스킬과 한글 문서 편집 MCP 도구",
  "mcpServers": {
    "hyeyum-hwpx-toolkit": {
      "command": "uv",
      "args": ["run", "--frozen", "--quiet", "--directory", "${extensionPath}${/}server", "src/server.py", "${workspacePath}"],
      "env": { "PYTHONDONTWRITEBYTECODE": "1" }
    }
  }
}
