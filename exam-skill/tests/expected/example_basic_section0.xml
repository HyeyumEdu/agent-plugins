<?xml version="1.0" encoding="UTF-8" standalone="yes" ?><hs:sec xmlns:ha="http://www.hancom.co.kr/hwpml/2011/app" xmlns:hp="http://www.hancom.co.kr/hwpml/2011/paragraph" xmlns:hp10="http://www.hancom.co.kr/hwpml/2016/paragraph" xmlns:hs="http://www.hancom.co.kr/hwpml/2011/section" xmlns:hc="http://www.hancom.co.kr/hwpml/2011/core" xmlns:hh="http://www.hancom.co.kr/hwpml/2011/head" xmlns:hhs="http://www.hancom.co.kr/hwpml/2011/history" xmlns:hm="http://www.hancom.co.kr/hwpml/2011/master-page" xmlns:hpf="http://www.hancom.co.kr/schema/2011/hpf" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:opf="http://www.idpf.org/2007/opf/" xmlns:ooxmlchart="http://www.hancom.co.kr/hwpml/2016/ooxmlchart" xmlns:hwpunitchar="http://www.hancom.co.kr/hwpml/2016/HwpUnitChar" xmlns:epub="http://www.idpf.org/2007/ops" xmlns:config="urn:oasis:names:tc:opendocument:xmlns:config:1.0"><hp:p id="3121190098" paraPrIDRef="61" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="52"><hp:secPr id="" textDirection="HORIZONTAL" spaceColumns="1134" tabStop="8000" tabStopVal="4000" tabStopUnit="HWPUNIT" outlineShapeIDRef="1" memoShapeIDRef="0" textVerticalWidthHead="0" masterPageCnt="0"><hp:grid lineGrid="0" charGrid="0" wonggojiFormat="0"/><hp:startNum pageStartsOn="BOTH" page="0" pic="0" tbl="0" equation="0"/><hp:visibility hideFirstHeader="0" hideFirstFooter="0" hideFirstMasterPage="0" border="SHOW_ALL" fill="SHOW_ALL" hideFirstPageNum="0" hideFirstEmptyLine="0" showLineNumber="0"/><hp:lineNumberShape restartType="0" countBy="0" distance="0" startNumber="0"/><hp:pagePr landscape="WIDELY" width="59528" height="84186" gutterType="LEFT_ONLY"><hp:margin header="4252" footer="4252" gutter="0" left="8504" right="8504" top="5668" bottom="4252"/></hp:pagePr><hp:footNotePr><hp:autoNumFormat type="DIGIT" userChar="" prefixChar="" suffixChar=")" supscript="0"/><hp:noteLine length="-1" type="SOLID" width="0.12 mm" color="#000000"/><hp:noteSpacing betweenNotes="283" belowLine="567" aboveLine="850"/><hp:numbering type="CONTINUOUS" newNum="1"/><hp:placement place="EACH_COLUMN" beneathText="0"/></hp:footNotePr><hp:endNotePr><hp:autoNumFormat type="DIGIT" userChar="" prefixChar="" suffixChar=")" supscript="0"/><hp:noteLine length="14692344" type="SOLID" width="0.12 mm" color="#000000"/><hp:noteSpacing betweenNotes="0" belowLine="567" aboveLine="850"/><hp:numbering type="CONTINUOUS" newNum="1"/><hp:placement place="END_OF_DOCUMENT" beneathText="0"/></hp:endNotePr><hp:pageBorderFill type="BOTH" borderFillIDRef="1" textBorder="PAPER" headerInside="0" footerInside="0" fillArea="PAPER"><hp:offset left="1417" right="1417" top="1417" bottom="1417"/></hp:pageBorderFill><hp:pageBorderFill type="EVEN" borderFillIDRef="1" textBorder="PAPER" headerInside="0" footerInside="0" fillArea="PAPER"><hp:offset left="1417" right="1417" top="1417" bottom="1417"/></hp:pageBorderFill><hp:pageBorderFill type="ODD" borderFillIDRef="1" textBorder="PAPER" headerInside="0" footerInside="0" fillArea="PAPER"><hp:offset left="1417" right="1417" top="1417" bottom="1417"/></hp:pageBorderFill></hp:secPr><hp:ctrl><hp:colPr id="" type="NEWSPAPER" layout="LEFT" colCount="2" sameSz="1" sameGap="2268"><hp:colLine type="SOLID" width="0.12 mm" color="#000000"/></hp:colPr></hp:ctrl></hp:run><hp:run charPrIDRef="52"/><hp:run charPrIDRef="53"><hp:t>예시고2</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="61" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="53"><hp:t>문학과 독서</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="61" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="53"><hp:t>2026-2학기 1차</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="0" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"/></hp:p><hp:p id="0" paraPrIDRef="90" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="10"><hp:t>※ 다음 글을 읽고 물음에 답하시오.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="90" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="31"/></hp:p><hp:p id="0" paraPrIDRef="32" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="10"><hp:t>등대는 어떻게 바다를 비출까</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="32" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t> 등대는 어두운 바다에서 배가 방향을 잡도록 돕는 시설이다. 등대의 불빛은 </hp:t></hp:run><hp:run charPrIDRef="32"><hp:t>일정한 간격으로 깜박이도록</hp:t></hp:run><hp:run charPrIDRef="0"><hp:t> 만들어, 멀리서도 다른 불빛과 구별할 수 있다. ㉠</hp:t></hp:run><hp:run charPrIDRef="32"><hp:t>등대마다 깜박이는 간격을 다르게 정하는 까닭</hp:t></hp:run><hp:run charPrIDRef="0"><hp:t>도 여기에 있다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="32" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"/></hp:p><hp:p id="0" paraPrIDRef="32" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t> 렌즈는 전구의 빛을 모아 한 방향으로 멀리 보낸다. 이렇게 모은 빛은 수십 킬로미터 밖에서도 보일 수 있지만, 짙은 안개가 끼면 빛이 흩어져 가시거리가 줄어든다. 그래서 안개가 짙은 날에는 불빛과 함께 소리를 내는 장치가 쓰이기도 한다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="43" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="3"><hp:t>- 출제자 창작</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="0" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"/></hp:p><hp:p id="0" paraPrIDRef="91" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="37"><hp:t>윗글의 내용과 일치하지 </hp:t></hp:run><hp:run charPrIDRef="38"><hp:t>않는</hp:t></hp:run><hp:run charPrIDRef="37"><hp:t> 것은? [3.6점]</hp:t><hp:ctrl><hp:endNote number="1" suffixChar="41" instId="1100000001"><hp:subList id="" textDirection="HORIZONTAL" lineWrap="BREAK" vertAlign="TOP" linkListIDRef="0" linkListNextIDRef="0" textWidth="0" textHeight="0" hasTextRef="0" hasNumRef="0"><hp:p id="0" paraPrIDRef="0" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:ctrl><hp:autoNum num="1" numType="ENDNOTE"><hp:autoNumFormat type="DIGIT" userChar="" prefixChar="" suffixChar=")" supscript="0"/></hp:autoNum></hp:ctrl><hp:t> </hp:t></hp:run><hp:run charPrIDRef="39"><hp:t>정답 ③   [3.6점]</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="47" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="40"><hp:t>출제 포인트  </hp:t></hp:run><hp:run charPrIDRef="0"><hp:t>지문의 세부 내용과 선택지를 하나씩 대조하는 문항.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="47" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="40"><hp:t>정답 해설  </hp:t></hp:run><hp:run charPrIDRef="0"><hp:t>렌즈는 빛을 모아 한 방향으로 멀리 보낸다고 했으므로 빛을 사방으로 흩뜨린다는 ③은 지문과 어긋난다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="48" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="40"><hp:t>오답 분석</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>① ‘배가 방향을 잡도록 돕는 시설이다’ — 지문 첫 문장과 일치한다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>② ‘일정한 간격으로 깜박이도록 만들어’ — 일치한다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>④ ‘짙은 안개가 끼면 빛이 흩어져 가시거리가 줄어든다’ — 일치한다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>⑤ ‘소리를 내는 장치가 쓰이기도 한다’ — 일치한다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"/></hp:p></hp:subList></hp:endNote></hp:ctrl><hp:t/></hp:run></hp:p><hp:p id="0" paraPrIDRef="92" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="58"><hp:t>①<hp:tab width="519" leader="0" type="1"/>등대는 배가 방향을 잡도록 돕는 시설이다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="92" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>②<hp:tab width="519" leader="0" type="1"/>등대의 불빛은 일정한 간격으로 깜박이도록 만든다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="92" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>③<hp:tab width="519" leader="0" type="1"/>렌즈는 빛을 사방으로 고르게 흩뜨려 보낸다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="92" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>④<hp:tab width="519" leader="0" type="1"/>짙은 안개가 끼면 불빛이 보이는 거리가 줄어든다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="93" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>⑤<hp:tab width="519" leader="0" type="1"/>안개가 짙은 날에는 소리를 내는 장치가 함께 쓰이기도 한다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="0" styleIDRef="0" pageBreak="0" columnBreak="1" merged="0"><hp:run charPrIDRef="0"/></hp:p><hp:p id="0" paraPrIDRef="91" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="37"><hp:t>윗글을 바탕으로 〈보기〉의 상황을 이해한 내용으로 가장 적절한 것은? [4.1점]</hp:t><hp:ctrl><hp:endNote number="2" suffixChar="41" instId="1100000002"><hp:subList id="" textDirection="HORIZONTAL" lineWrap="BREAK" vertAlign="TOP" linkListIDRef="0" linkListNextIDRef="0" textWidth="0" textHeight="0" hasTextRef="0" hasNumRef="0"><hp:p id="0" paraPrIDRef="0" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:ctrl><hp:autoNum num="2" numType="ENDNOTE"><hp:autoNumFormat type="DIGIT" userChar="" prefixChar="" suffixChar=")" supscript="0"/></hp:autoNum></hp:ctrl><hp:t> </hp:t></hp:run><hp:run charPrIDRef="39"><hp:t>정답 ④   [4.1점]</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="47" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="40"><hp:t>출제 포인트  </hp:t></hp:run><hp:run charPrIDRef="0"><hp:t>지문의 정보를 새로운 상황에 적용하는 문항.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="47" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="40"><hp:t>정답 해설  </hp:t></hp:run><hp:run charPrIDRef="0"><hp:t>안개 때문에 불빛이 보이지 않을 때 소리를 내는 장치가 함께 쓰인다는 지문 내용이 〈보기〉의 뱃고동 소리와 이어진다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="48" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="40"><hp:t>오답 분석</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>① ‘렌즈가 고장’ — 지문에 근거가 없다. 안개가 원인이다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>② ‘깜박이는 간격이 같아서’ — 〈보기〉에 간격 이야기는 없다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>③ ‘간격을 대신 정해’ — 소리 장치는 불빛의 간격과 무관하다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>⑤ ‘한 방향으로 모아 멀리 보내는 데 성공’ — 〈보기〉는 불빛이 보이지 않는 상황이다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="49" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"/></hp:p></hp:subList></hp:endNote></hp:ctrl><hp:t/></hp:run></hp:p><hp:p id="0" paraPrIDRef="94" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:tbl id="1000000001" zOrder="0" numberingType="TABLE" textWrap="TOP_AND_BOTTOM" textFlow="BOTH_SIDES" lock="0" dropcapstyle="None" pageBreak="TABLE" repeatHeader="1" rowCnt="1" colCnt="1" cellSpacing="0" borderFillIDRef="8" noAdjust="0"><hp:sz width="20038" widthRelTo="ABSOLUTE" height="7800" heightRelTo="ABSOLUTE" protect="0"/><hp:pos treatAsChar="1" affectLSpacing="0" flowWithText="1" allowOverlap="0" holdAnchorAndSO="0" vertRelTo="PARA" horzRelTo="PARA" vertAlign="TOP" horzAlign="LEFT" vertOffset="0" horzOffset="0"/><hp:outMargin left="0" right="0" top="0" bottom="0"/><hp:inMargin left="540" right="540" top="0" bottom="0"/><hp:tr><hp:tc name="" header="0" hasMargin="1" protect="0" editable="0" dirty="0" borderFillIDRef="9"><hp:subList id="" textDirection="HORIZONTAL" lineWrap="BREAK" vertAlign="TOP" linkListIDRef="0" linkListNextIDRef="0" textWidth="0" textHeight="0" hasTextRef="0" hasNumRef="0"><hp:p id="0" paraPrIDRef="54" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="41"><hp:t>〈 보 기 〉</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="85" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>안개가 짙게 낀 항구에서 한 선장은 등대의 불빛이 보이지 않자 울려 퍼지는 뱃고동 소리에 의지해 배의 방향을 잡았다.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="42" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="3"><hp:t>출제자 창작</hp:t></hp:run></hp:p></hp:subList><hp:cellAddr colAddr="0" rowAddr="0"/><hp:cellSpan colSpan="1" rowSpan="1"/><hp:cellSz width="20038" height="0"/><hp:cellMargin left="550" right="550" top="400" bottom="400"/></hp:tc></hp:tr></hp:tbl><hp:t/></hp:run></hp:p><hp:p id="0" paraPrIDRef="92" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="58"><hp:t>①<hp:tab width="519" leader="0" type="1"/>렌즈가 고장 나 불빛이 사라진 상황이겠군.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="92" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>②<hp:tab width="519" leader="0" type="1"/>깜박이는 간격이 같아서 등대를 구별하지 못한 상황이겠군.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="92" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>③<hp:tab width="519" leader="0" type="1"/>소리 장치가 불빛의 간격을 대신 정해 준 상황이겠군.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="92" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>④<hp:tab width="519" leader="0" type="1"/>빛이 흩어져 가시거리가 줄어든 상황에서 소리 장치가 쓰인 사례이겠군.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="93" styleIDRef="0" pageBreak="0" columnBreak="0" merged="0"><hp:run charPrIDRef="0"><hp:t>⑤<hp:tab width="519" leader="0" type="1"/>전구의 빛을 한 방향으로 모아 멀리 보내는 데 성공한 사례이겠군.</hp:t></hp:run></hp:p><hp:p id="0" paraPrIDRef="0" styleIDRef="0" pageBreak="1" columnBreak="0" merged="0"><hp:run charPrIDRef="59"><hp:t>정답과 해설</hp:t></hp:run></hp:p></hs:sec>